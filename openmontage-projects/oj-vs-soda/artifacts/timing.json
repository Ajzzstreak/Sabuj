  "segments": [
    {
      "id": "cold",
      "kind": "cold",
      "start": 0.15,
      "end": 2.971,
      "sentences": [
        {
          "text": "Your morning orange juice might be closer to soda than you think.",
          "start": 0.15,
          "end": 2.971
        }
      ]
    },
    {
      "id": "sugar",
      "kind": "sugar",
      "start": 3.571,
      "end": 12.176,
      "sentences": [
        {
          "text": "One glass of orange juice. About twenty one grams of sugar.",
          "start": 3.571,
          "end": 7.05
        },
        {
          "text": "The same amount of cola. About twenty six grams.",
          "start": 7.45,
          "end": 10.36
        },
        {
          "text": "That's only five grams apart.",
          "start": 10.76,
          "end": 12.176
        }
      ]
    },
    {
      "id": "nutr",
      "kind": "nutr",
      "start": 12.776,
      "end": 21.261,
      "sentences": [
        {
          "text": "To be fair, juice brings vitamin C and potassium. Soda brings nothing.",
          "start": 12.776,
          "end": 17.149
        },
        {
          "text": "But both have almost zero fiber, so the sugar hits your blood fast.",
          "start": 17.549,
          "end": 21.261
        }
      ]
    },
    {
      "id": "orange",
      "kind": "orange",
      "start": 21.861,
      "end": 27.012,
      "sentences": [
        {
          "text": "Now the actual orange. Twelve grams of sugar, three grams of fiber, and it keeps you full.",
          "start": 21.861,
          "end": 27.012
        }
      ]
    },
    {
      "id": "verdict",
      "kind": "verdict",
      "start": 27.612,
      "end": 34.709,
      "sentences": [
        {
          "text": "Verdict. Soda: bad. Juice: watch out. The orange: good.",
          "start": 27.612,
          "end": 31.883
        },
        {
          "text": "And it costs about the same as a glass of juice.",
          "start": 32.283,
          "end": 34.709
        }
      ]
    },
    {
      "id": "end",
      "kind": "end",
      "start": 35.309,
      "end": 38.951,
      "sentences": [
        {
          "text": "Follow for more good or bad.",
          "start": 35.309,
          "end": 36.972
        },
        {
          "text": "Now, back to that glass.",
          "start": 37.372,
          "end": 38.951
        }
      ]
    }
  ],
