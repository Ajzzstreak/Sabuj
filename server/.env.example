# --- HTTP ---
PORT=8787
HOST=0.0.0.0
# Allowed CORS origin(s): "*" or a comma-separated list of origins.
CORS_ORIGIN=*
# Number of reverse-proxy hops in front of this server ("true" = 1). Leave false when clients connect directly.
# Only the entries appended by your own proxies are trusted; a client-supplied X-Forwarded-For is ignored.
TRUST_PROXY=false
# Max JSON body size in bytes (any POST/PUT body).
BODY_LIMIT_BYTES=65536
LOG_LEVEL=info

# --- Persistence ---
DB_PATH=./data/deallens.db
# Oldest events beyond this many per device are pruned.
MAX_EVENTS_PER_DEVICE=5000

# --- Devices (POST /v1/devices issues {deviceId, token}; only a SHA-256 hash of the token is stored) ---
# Registrations per IP per RATE_LIMIT_WINDOW_MS, and per IP per 24 hours.
DEVICE_REGISTRATION_RATE_MAX=5
DEVICE_REGISTRATIONS_PER_IP_PER_DAY=30
# Retention: a device with no authenticated request for this many days is erased with all its data.
DEVICE_RETENTION_DAYS=180
# Hard ceiling on registered devices; registration answers 503 above it.
MAX_DEVICES=1000000

# --- Price providers ---
# Comma-separated provider names: mock | bestbuy | walmart (see src/providers/index.ts).
# bestbuy and walmart are OFF unless listed here and are UNVERIFIED AGAINST THE LIVE APIs:
# read the header of src/providers/bestbuy.ts / walmart.ts and the README checklist first.
PRICE_PROVIDERS=mock
PROVIDER_TIMEOUT_MS=2500
# Limit the whole catalog to these category names (comma-separated, case-insensitive), e.g. "Rice Cookers".
# Empty = everything.
CATALOG_CATEGORIES=
# Artificial latency added to every MockProvider call, to simulate a real upstream.
MOCK_LATENCY_MS=0
# Dev/test hook: pin mock prices at startup, "productId:retailerId=price[,...]",
# e.g. dash-mini-2-cup-rice-cooker:amazon=9.99 (lets you exercise a price-drop alert).
MOCK_PRICE_OVERRIDES=
# Best Buy Products API key (only read when PRICE_PROVIDERS includes bestbuy).
BESTBUY_API_KEY=
# Walmart Affiliate API credentials (only read when PRICE_PROVIDERS includes walmart).
# WALMART_PRIVATE_KEY is the PEM (PKCS#8) private key on one line with \n for newlines.
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY=
WALMART_KEY_VERSION=1
WALMART_PUBLISHER_ID=

# --- Cache (in-memory LRU, shared across users) ---
CACHE_MAX_ENTRIES=2000
CACHE_TTL_MS=60000
CACHE_SWR_MS=600000

# --- Rate limiting (fixed window, per IP and per device) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_EVENTS_MAX=60
# POST /v1/ask per device per window.
ASK_RATE_LIMIT_MAX=10

# --- Profile learning ---
PROFILE_DEBOUNCE_MS=1500
# Optional. When unset, only the heuristic profiler runs and POST /v1/ask uses the rules parser.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Run the Claude profiler after this many new events per device...
CLAUDE_PROFILE_EVERY_N_EVENTS=25
# ...and at most once per this window per device.
CLAUDE_PROFILE_COOLDOWN_MS=3600000
CLAUDE_TIMEOUT_MS=30000
# Global ceiling on Claude calls per hour across ALL devices, shared by the profiler and
# POST /v1/ask (cost bound; 0 disables Claude).
CLAUDE_MAX_CALLS_PER_HOUR=200
# Hard deadline for the Claude call inside POST /v1/ask; after it the rules parser answers.
ASK_TIMEOUT_MS=4000

# --- Price alerts and push ---
MAX_ALERTS_PER_DEVICE=20
# How often the background checker evaluates active alerts. 0 disables it.
ALERT_CHECK_INTERVAL_MS=900000
# expo = POST to https://exp.host/--/api/v2/push/send ; none = never send pushes.
PUSH_PROVIDER=expo
PUSH_TIMEOUT_MS=5000
# Only needed if the Expo project has "enhanced security for push notifications" enabled.
EXPO_ACCESS_TOKEN=
