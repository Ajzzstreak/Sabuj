# --- HTTP ---
PORT=8787
HOST=0.0.0.0
# Allowed CORS origin(s): "*" or a comma-separated list of origins.
CORS_ORIGIN=*
# Number of reverse-proxy hops in front of this server ("true" = 1). Leave false when clients connect directly.
# Only the entries appended by your own proxies are trusted; a client-supplied X-Forwarded-For is ignored.
TRUST_PROXY=false
# Max JSON body size in bytes (POST /v1/events).
BODY_LIMIT_BYTES=65536
LOG_LEVEL=info

# --- Persistence ---
DB_PATH=./data/deallens.db
# Oldest events beyond this many per device are pruned.
MAX_EVENTS_PER_DEVICE=5000

# --- Price providers ---
# Comma-separated provider names. Only "mock" ships today (see src/providers/index.ts).
PRICE_PROVIDERS=mock
PROVIDER_TIMEOUT_MS=2500
# Artificial latency added to every MockProvider call, to simulate a real upstream.
MOCK_LATENCY_MS=0

# --- Cache (in-memory LRU, shared across users) ---
CACHE_MAX_ENTRIES=2000
CACHE_TTL_MS=60000
CACHE_SWR_MS=600000

# --- Rate limiting (fixed window, per IP and per deviceId) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_EVENTS_MAX=60

# --- Profile learning ---
PROFILE_DEBOUNCE_MS=1500
# Optional. When unset, only the heuristic profiler runs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Run the Claude profiler after this many new events per device...
CLAUDE_PROFILE_EVERY_N_EVENTS=25
# ...and at most once per this window per device.
CLAUDE_PROFILE_COOLDOWN_MS=3600000
CLAUDE_TIMEOUT_MS=30000
# Global ceiling on Claude profiler calls per hour across ALL devices (cost bound; 0 disables Claude).
CLAUDE_MAX_CALLS_PER_HOUR=200
